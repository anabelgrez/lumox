[{"id":"horizon_angle","name":"Terrain elevation angle","latex":"\\theta = \\operatorname{atan2}\\big((R+z_t)\\cos\\psi - (R+z_s+h),\\ (R+z_t)\\sin\\psi\\big),\\ \\psi = d/R","description":"Angle of a terrain point above the observer's horizontal plane, exact on the lunar sphere.","inputs":[{"name":"h_m","unit":"m","description":"mast height","default":2.0},{"name":"d_m","unit":"m","description":"distance to the terrain point","default":5000.0},{"name":"z_t_m","unit":"m","description":"terrain height","default":150.0},{"name":"z_s_m","unit":"m","description":"site height","default":0.0}],"output":{"name":"theta","unit":"deg","description":"elevation angle","default":null},"source":"IAU WGCCRE 2015 mean lunar radius 1737.4 km (Archinal et al. 2018)"},{"id":"angular_radius","name":"Angular radius of a body","latex":"\\rho = \\arcsin(R_b / \\Delta)","description":"Half the apparent diameter of the Sun or the Earth from the site.","inputs":[{"name":"radius_m","unit":"m","description":"body radius","default":695700000.0},{"name":"range_m","unit":"m","description":"distance to the body","default":149597870700.0}],"output":{"name":"rho","unit":"deg","description":"angular radius","default":null},"source":"IAU 2015 Resolution B3 nominal solar radius"},{"id":"disc_segment","name":"Visible disc fraction (segment)","latex":"x = \\frac{h-\\theta}{\\rho},\\ f = \\frac{\\arccos(-x) + x\\sqrt{1-x^2}}{\\pi}","description":"Fraction of a disc above a straight horizon.","inputs":[{"name":"el_deg","unit":"deg","description":"body elevation","default":0.1},{"name":"theta_deg","unit":"deg","description":"horizon elevation","default":0.0},{"name":"rho_deg","unit":"deg","description":"angular radius","default":0.267}],"output":{"name":"f","unit":"","description":"visible fraction","default":null},"source":""},{"id":"irradiance","name":"Solar irradiance","latex":"S = S_0 (\\mathrm{AU}/r)^2","description":"Total solar irradiance at distance r.","inputs":[{"name":"range_m","unit":"m","description":"distance to the Sun","default":149597870700.0}],"output":{"name":"S","unit":"W/m^2","description":"irradiance","default":null},"source":"Total solar irradiance at 1 AU, Kopp & Lean (2011) GRL 38, L01706"},{"id":"panel_power","name":"Panel power","latex":"P = S A \\eta \\cos i\\, f","description":"Electrical power of a solar panel.","inputs":[{"name":"S_wm2","unit":"W/m^2","description":"irradiance","default":1361.0},{"name":"area_m2","unit":"m^2","description":"panel area","default":10.0},{"name":"eta","unit":"","description":"efficiency","default":0.3},{"name":"cos_i","unit":"","description":"cosine of incidence angle","default":1.0},{"name":"f","unit":"","description":"visible disc fraction","default":1.0}],"output":{"name":"P","unit":"W","description":"power","default":null},"source":""},{"id":"autonomy","name":"Battery autonomy","latex":"T_{aut} = C / P_{load}","description":"Hours the battery sustains the load.","inputs":[{"name":"battery_wh","unit":"Wh","description":"battery capacity","default":20000.0},{"name":"load_w","unit":"W","description":"load","default":500.0}],"output":{"name":"T_aut","unit":"h","description":"autonomy","default":null},"source":""},{"id":"night_ratio","name":"Night / autonomy ratio","latex":"r = T_{night} / T_{aut}","description":"Survival ratio used by the verdict.","inputs":[{"name":"longest_night_h","unit":"h","description":"longest night","default":30.0},{"name":"autonomy_h","unit":"h","description":"battery autonomy","default":40.0}],"output":{"name":"r","unit":"","description":"ratio","default":null},"source":""},{"id":"curvature_drop","name":"Curvature drop","latex":"\\delta = R - \\sqrt{R^2 - d^2}","description":"How far the lunar surface falls below the tangent plane at distance d.","inputs":[{"name":"d_m","unit":"m","description":"distance","default":10000.0}],"output":{"name":"delta","unit":"m","description":"drop","default":null},"source":"IAU WGCCRE 2015 mean lunar radius 1737.4 km (Archinal et al. 2018)"},{"id":"parallax_bound","name":"Parallax bound","latex":"\\delta A \\le s / \\Delta","description":"Maximum direction change from moving s metres (used to justify reusing the ephemeris).","inputs":[{"name":"offset_m","unit":"m","description":"ground offset","default":5657.0},{"name":"range_m","unit":"m","description":"distance to the body","default":384400000.0}],"output":{"name":"dA","unit":"deg","description":"angle","default":null},"source":""}]